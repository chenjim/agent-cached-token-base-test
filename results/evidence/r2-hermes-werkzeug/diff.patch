+# https://httpwg.org/specs/rfc9110.html#entity-tags
+# An entity-tag must be a quoted string, optionally preceded by a weak
+# marker. Anything else is invalid and is discarded while parsing.
 _etag_re = re.compile(
     r"""
-    (?:^|[ \t]*,[ \t]*)  # start or preceded by comma
+    [ \t]*  # ignore leading space
     ([Ww]/)?  # optional weak marker
-    (?:
-        "([^"]*)"  # quoted value
-    |
-        ([^" \t,]+)  # invalid unquoted value, exclude syntax characters
-    )
-    (?=[ \t]*,[ \t]*|$)  # only if followed by comma or end
+    "([^"]*)"  # quoted value
+    [ \t]*  # ignore trailing space
+    (?:,|\Z)  # only if followed by comma or end
     """,
     flags=re.ASCII | re.VERBOSE,
 )
@@ -76,6 +76,10 @@ class ETags(cabc.Collection[str]):
         from ..http import unquote_etag
 
         etag, weak = unquote_etag(etag)
+
+        if etag is None:
+            return False
+
         if weak:
             return self.contains_weak(etag)
         return self.contains(etag)
