         """
@@ -94,14 +99,23 @@ class ETags(cabc.Collection[str]):
 
         strong = []
         weak = []
+        pos = 0
+
+        while True:
+            if (match := _etag_re.match(value, pos)) is None:
+                # Skip invalid characters until the next comma or end.
+                if (pos := value.find(",", pos) + 1) == 0:
+                    break
+
+                continue
 
-        for match in _etag_re.finditer(value):
-            is_weak, tag, invalid_unquoted = match.groups()
+            is_weak, tag = match.groups()
+            pos = match.end()
 
             if is_weak:
-                weak.append(tag or invalid_unquoted)
+                weak.append(tag)
             else:
-                strong.append(tag or invalid_unquoted)
+                strong.append(tag)
 
         return cls(strong, weak)
 
