+def shorten_message(message: str, budget: int = 500) -> str:
+    """Shorten a JUnit ``message`` attribute to roughly ``budget`` characters.
+
+    Some XML parsers reject very long attribute values, so the message is cut
+    on a line boundary when possible (or in the middle of the first line as a
+    last resort) and a marker pointing at the element text is appended. The
+    full report is still available as the element text.
+
+    Shortening must happen *before* escaping, otherwise an escape sequence
+    such as ``#x1B`` could be cut in half.
+    """
+    if len(message) <= budget:
+        return message
+
+    lines = message.splitlines()
+    kept: list[str] = []
+    used = 0
+    for line in lines:
+        # +1 for the newline separating it from the previous kept line.
+        cost = len(line) + (1 if kept else 0)
+        if used + cost > budget:
+            break
+        kept.append(line)
+        used += cost
+
+    if not kept:
+        # The very first line alone is longer than the budget: cut it.
+        text = lines[0][:budget] + "..."
+        remaining = len(lines) - 1
+    else:
+        text = "\n".join(kept)
+        remaining = len(lines) - len(kept)
+
+    if remaining:
+        noun = "line" if remaining == 1 else "lines"
+        marker = f"[+{remaining} more {noun}; full report in element text]"
+    else:
+        marker = "[truncated; full report in element text]"
+    return f"{text}\n{marker}"
+
