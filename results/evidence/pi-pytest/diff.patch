+def shorten_message(message: str, *, budget: int = 500) -> str:
+    """Shorten a message so it can safely be stored in an XML attribute.
+
+    The full report is still written as the element text; only the ``message``
+    attribute is shortened. Lines are kept whole where possible to keep the
+    result readable.
+    """
+    if len(message) <= budget:
+        return message
+
+    lines = message.split("\n")
+    kept_lines: list[str] = []
+    used = 0
+    for line in lines:
+        # Account for the newline separating this line from the previous one.
+        cost = len(line) + (1 if kept_lines else 0)
+        if used + cost > budget:
+            break
+        kept_lines.append(line)
+        used += cost
+
+    if not kept_lines:
+        # The first line alone is longer than the budget: truncate it.
+        truncated = lines[0][:budget] + "..."
+        remaining = len(lines) - 1
+        if remaining:
+            plural = "s" if remaining != 1 else ""
+            return (
+                f"{truncated}\n[+{remaining} more line{plural}; "
+                "full report in element text]"
+            )
+        return f"{truncated}\n[truncated; full report in element text]"
+
+    remaining = len(lines) - len(kept_lines)
+    plural = "s" if remaining != 1 else ""
+    return (
+        "\n".join(kept_lines)
+        + f"\n[+{remaining} more line{plural}; full report in element text]"
+    )
+
