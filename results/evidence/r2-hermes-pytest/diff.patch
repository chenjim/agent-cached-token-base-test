+def shorten_message(message: str, budget: int = 500) -> str:
+    """Shorten *message* to roughly *budget* characters.
+
+    The ``message`` attribute of ``<failure>`` and ``<error>`` elements is not
+    meant to carry the full report (that is the element text): very long
+    messages, such as a diff produced by ``-vv``, can produce attributes of
+    tens of thousands of characters which some XML parsers reject.
+
+    The message is truncated on line boundaries, so the result never ends in
+    the middle of a line unless a single line alone exceeds the budget. A
+    notice pointing at the element text is appended when anything was cut.
+    Shortening happens on the raw text, before XML escaping, so escapes are
+    never split.
+    """
+    if len(message) <= budget:
+        return message
+
+    lines = message.splitlines()
+    kept_lines: list[str] = []
+    used = 0
+    for line in lines:
+        # +1 for the newline separating this line from the previous ones.
+        extra = len(line) + (1 if kept_lines else 0)
+        if used + extra > budget:
+            break
+        kept_lines.append(line)
+        used += extra
+
+    if kept_lines:
+        removed = len(lines) - len(kept_lines)
+        if removed <= 0:
+            # Only the raw text was too long (e.g. \r\n line endings).
+            return "\n".join(kept_lines)
+        return (
+            "\n".join(kept_lines)
+            + f"\n[+{removed} more line{'' if removed == 1 else 's'}; {_FULL_REPORT}]"
+        )
+
+    # The first line alone exceeds the budget: cut it hard.
+    removed = len(lines) - 1
+    if removed <= 0:
+        notice = f"[truncated; {_FULL_REPORT}]"
+    else:
+        notice = f"[+{removed} more line{'' if removed == 1 else 's'}; {_FULL_REPORT}]"
+    return f"{lines[0][:budget]}...\n{notice}"
+
