+# Long messages (e.g. assertion diffs at -vv) blow up the ``message`` attribute
+# of <failure>/<error> nodes; some XML parsers reject very large attributes.
+# Keep the attribute readable and put the full report in the element text.
+MAX_MESSAGE_LENGTH = 500
+
+_TRUNCATED_SUFFIX = "[truncated; full report in element text]"
+
+
+def _remaining_lines_suffix(count: int) -> str:
+    if count == 0:
+        return _TRUNCATED_SUFFIX
+    plural = "" if count == 1 else "s"
+    return f"[+{count} more line{plural}; full report in element text]"
+
+
+def shorten_message(message: str, budget: int = MAX_MESSAGE_LENGTH) -> str:
+    """Shorten a JUnit XML ``message`` attribute to roughly ``budget`` chars.
+
+    The message is cut on line boundaries when possible; a single over-long
+    line is cut at ``budget`` characters and marked with ``...``. The cut is
+    done on the raw text so that XML escaping can never split an escape
+    sequence. The full, unshortened report stays in the element text.
+    """
+    if len(message) <= budget:
+        return message
+
+    lines = message.split("\n")
+    first_line = lines[0]
+    if len(first_line) > budget:
+        return f"{first_line[:budget]}...\n{_remaining_lines_suffix(len(lines) - 1)}"
+
+    kept: list[str] = []
+    used = 0
+    for index, line in enumerate(lines):
+        extra = len(line) + (1 if kept else 0)
+        if used + extra > budget:
+            return "\n".join(kept) + "\n" + _remaining_lines_suffix(len(lines) - index)
+        kept.append(line)
+        used += extra
+    return message
+
