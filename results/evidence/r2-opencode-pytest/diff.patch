+#: Maximum length of the ``message`` attribute of ``<failure>``/``<error>``
+#: elements. Long messages are truncated: some XML parsers reject huge
+#: attribute values. The full report is kept in the element text.
+_MESSAGE_ATTRIBUTE_BUDGET = 500
+
+
+def shorten_message(message: str, budget: int = _MESSAGE_ATTRIBUTE_BUDGET) -> str:
+    """Shorten a message for use in a JUnit XML attribute.
+
+    Messages which fit in *budget* characters are returned unchanged. Longer
+    messages are cut on a line boundary (a single overlong first line is cut at
+    *budget*) and a note is appended, as the full report is available in the
+    element text.
+
+    This is applied before :func:`bin_xml_escape` so that escape sequences are
+    never split in half.
+    """
+    if len(message) <= budget:
+        return message
+
+    lines = message.split("\n")
+    kept: list[str] = []
+    used = 0
+    for line in lines:
+        # +1 accounts for the newline joining this line to the previous one.
+        needed = len(line) + (1 if kept else 0)
+        if used + needed > budget:
+            break
+        kept.append(line)
+        used += needed
+
+    remaining = len(lines) - len(kept)
+    if kept:
+        return "\n".join(kept) + "\n" + _truncation_note(remaining)
+    # The first line alone does not fit: cut it mid-line.
+    return lines[0][:budget] + "...\n" + _truncation_note(remaining - 1)
+
+
+def _truncation_note(remaining: int) -> str:
+    """Describe how much of a shortened message was omitted."""
+    if remaining <= 0:
+        return "[truncated; full report in element text]"
+    plural = "s" if remaining > 1 else ""
+    return f"[+{remaining} more line{plural}; full report in element text]"
+
